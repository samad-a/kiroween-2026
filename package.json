{
  "name": "club-kiro",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest --run",
    "evals": "node --env-file=.env node_modules/tsx/dist/cli.mjs server/src/caretaker/evals.ts",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start:server": "npm run start --workspace server",
    "svg-check": "node scripts/svg-check.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "fast-check": "4.10.2",
    "playwright-core": "1.64.1",
    "svgo": "4.1.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
