# Copy to .env and fill in. .env is gitignored and never committed (the repo is public).
# The Caretaker's runtime AI is paid for with your own key, not Kiro credits.

# Which provider the moderate() function uses: "bedrock" or "nebius".
CARETAKER_PROVIDER=bedrock

# A small, fast model's ID for the chosen provider.
CARETAKER_MODEL_ID=

# --- Amazon Bedrock ---
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=

# --- Nebius Token Factory (fallback) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=

# Server port (optional; defaults to 2567)
PORT=2567
