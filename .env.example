# Club Kiro — server environment. Copy to .env and fill in. Never commit .env.
# The repo is public: keep real keys out of version control.

# --- Server ---
# Port the Colyseus server listens on (host platforms usually set this for you).
PORT=2567

# Where the SQLite database lives. Point this at a PERSISTENT disk in production
# so coins, items and rooms survive restarts. Defaults to server/data/club-kiro.db.
DB_PATH=

# --- Caretaker (chat moderation) ---
# Which provider to use: "stub" (offline, default), "nebius", or "bedrock".
# With "stub" the game runs on the basic filter and needs no keys.
CARETAKER_PROVIDER=stub

# Model id for the chosen provider (e.g. a Nebius or Bedrock model name).
CARETAKER_MODEL_ID=

# Nebius (OpenAI-compatible). Required when CARETAKER_PROVIDER=nebius.
NEBIUS_BASE_URL=
NEBIUS_API_KEY=

# Amazon Bedrock. Required when CARETAKER_PROVIDER=bedrock.
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=

# --- Client (build-time) ---
# The deployed server's WebSocket URL, baked into the client at build time.
# Use wss:// when the site is served over https. Example: wss://your-server.example.com
# If unset, the client falls back to the same host on the default port.
VITE_SERVER_URL=
