# Copy to .env and fill in. .env is gitignored and never committed (the repo is public).
# The Caretaker's runtime AI is paid for with your own key, not Kiro credits.

# Which provider the moderate() function uses: "bedrock", "nebius", or unset for the offline stub.
CARETAKER_PROVIDER=bedrock

# A small, fast model's ID for the chosen provider.
CARETAKER_MODEL_ID=eu.amazon.nova-micro-v1:0

# --- Amazon Bedrock (Nova, Converse API) ---
AWS_REGION=eu-north-1
AWS_BEARER_TOKEN_BEDROCK=

# --- Nebius Token Factory (OpenAI-compatible fallback) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=

# Server port (optional; defaults to 2567)
PORT=2567
